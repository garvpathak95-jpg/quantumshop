from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(
    title="QuantumShop Product Catalog",
    version="0.1.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

PRODUCTS = [
    {
        "id": 1,
        "name": "Quantum Sneakers",
        "description": "Lightweight everyday sneakers.",
        "price": 2499,
        "emoji": "👟",
    },
    {
        "id": 2,
        "name": "Quantum T-Shirt",
        "description": "Comfortable cotton t-shirt.",
        "price": 799,
        "emoji": "👕",
    },
    {
        "id": 3,
        "name": "Quantum Backpack",
        "description": "Durable backpack for daily use.",
        "price": 1499,
        "emoji": "🎒",
    },
    {
        "id": 4,
        "name": "Quantum Headphones",
        "description": "Wireless headphones for work and travel.",
        "price": 3999,
        "emoji": "🎧",
    },
]

@app.get("/")
def root():
    return {"service": "product-service", "status": "ok"}

@app.get("/health")
def health():
    return {"status": "healthy"}

@app.get("/products")
def get_products():
    return PRODUCTS

@app.get("/products/{product_id}")
def get_product(product_id: int):
    for product in PRODUCTS:
        if product["id"] == product_id:
            return product
    return {"error": "Product not found"}